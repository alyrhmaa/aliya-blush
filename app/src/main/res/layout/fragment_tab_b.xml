<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFF1F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Program Kerja Utama"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#C2185B"
        android:fontFamily="@font/poppins_boldd"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EC407A"
        android:layout_marginVertical="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Digitalisasi UMKM Desa\n2. Pelatihan Literasi Digital Remaja\n3. Pembuatan Website Profil Desa\n4. Sosialisasi Keamanan Siber"
        android:textSize="16sp"
        android:textColor="#880E4F"
        android:fontFamily="@font/poppins_regularr"
        android:lineSpacingExtra="8dp"/>

</LinearLayout>